+import { applyResult, START_RATING, type EloResult } from "./elo";
+
+export type ReplayEntry = {
+  albumId: number;
+  year: number;
+  placement: "ranked" | "honorable_mention" | "listed";
+  rank: number | null;
+};
+
+export type ReplayMatchup = {
+  id: number;
+  albumAId: number;
+  albumBId: number;
+  result: EloResult;
+  createdAt: string;
+};
+
+export type ImpliedResult = { winnerId: number; loserId: number };
+
+/**
+ * The results a year's placements imply, in replay order: years ascending; within a year each ranked album
+ * (rank 1 first) beats the ranked albums below it, then the honorable mentions (album id order).
+ * Honorable mentions and listed albums don't play each other.
+ */
+export function impliedResults(entries: ReplayEntry[]): ImpliedResult[] {
+  const years = [...new Set(entries.map((entry) => entry.year))].sort((a, b) => a - b);
+  const results: ImpliedResult[] = [];
+  for (const year of years) {
+    const inYear = entries.filter((entry) => entry.year === year);
+    const ranked = inYear
+      .filter((entry) => entry.placement === "ranked")
+      .sort((a, b) => a.rank! - b.rank!);
+    const mentions = inYear
+      .filter((entry) => entry.placement === "honorable_mention")
+      .sort((a, b) => a.albumId - b.albumId);
+    ranked.forEach((winner, i) => {
+      for (const loser of [...ranked.slice(i + 1), ...mentions]) {
+        results.push({ winnerId: winner.albumId, loserId: loser.albumId });
+      }
+    });
+  }
+  return results;
+}
+
+/**
+ * Replays the implied results, then the explicit matchups oldest first (created at, then id), from 1500.
+ * A matchup with an unrated album is skipped, so `used` lists only the matchups that counted.
+ */
+export function computeRatings(input: { entries: ReplayEntry[]; matchups: ReplayMatchup[] }): {
+  ratings: Map<number, number>;
+  used: ReplayMatchup[];
+} {
+  const ratings = new Map<number, number>();
+  for (const entry of input.entries) {
+    if (entry.placement !== "listed") ratings.set(entry.albumId, START_RATING);
+  }
+
+  const play = (aId: number, bId: number, result: EloResult) => {
+    const next = applyResult(ratings.get(aId)!, ratings.get(bId)!, result);
+    ratings.set(aId, next.a);
+    ratings.set(bId, next.b);
+  };
+
+  for (const { winnerId, loserId } of impliedResults(input.entries)) play(winnerId, loserId, "a");
+
+  const sorted = [...input.matchups].sort(
+    (a, b) => (a.createdAt < b.createdAt ? -1 : a.createdAt > b.createdAt ? 1 : 0) || a.id - b.id,
+  );
+  const used: ReplayMatchup[] = [];
+  for (const matchup of sorted) {
+    if (!ratings.has(matchup.albumAId) || !ratings.has(matchup.albumBId)) continue;
+    play(matchup.albumAId, matchup.albumBId, matchup.result);
+    used.push(matchup);
+  }
+  return { ratings, used };
+}
diff --git a/lib/matchups-service.test.ts b/lib/matchups-service.test.ts
new file mode 100644
index 0000000..fac9e2c
--- /dev/null
+++ b/lib/matchups-service.test.ts
@@ -0,0 +1,103 @@
+import type { DatabaseSync } from "node:sqlite";
+import { beforeEach, describe, expect, it } from "vitest";
+import { countMatchups, listMatchups } from "./db/matchups";
+import { addYearEntry } from "./db/year-entries";
+import { memoryDb, seedAlbums } from "./db/test-db";
+import { answerMatchup, skipMatchup, undoMatchup, type MatchupView } from "./matchups-service";
+import { loadMatchupState, loadRatings } from "./ratings";
+
+const random = () => 0;
+
+function asView(result: ReturnType<typeof answerMatchup>): MatchupView {
+  if ("error" in result) throw new Error(result.error);
+  return result;
+}
+
+describe("matchup actions", () => {
+  let db: DatabaseSync;
+  let ids: number[];
+
+  beforeEach(() => {
+    db = memoryDb();
+    ids = seedAlbums(db, 6);
+    // 0 and 1 in 2000, 2 in 2001, 3 a honorable mention in 2002, 4 listed in 2003, 5 has no year entry.
+    addYearEntry(db, { albumId: ids[0], year: 2000, placement: "ranked", rank: 1 });
+    addYearEntry(db, { albumId: ids[1], year: 2000, placement: "ranked", rank: 2 });
+    addYearEntry(db, { albumId: ids[2], year: 2001, placement: "ranked", rank: 1 });
+    addYearEntry(db, { albumId: ids[3], year: 2002, placement: "honorable_mention" });
+    addYearEntry(db, { albumId: ids[4], year: 2003, placement: "listed" });
+  });
+
+  it("an answer moves both ratings and counts the matchup", () => {
+    const before = loadRatings(db).ratings;
+    const next = asView(answerMatchup(db, ids[0], ids[2], "b", [], random));
+
+    const after = loadRatings(db).ratings;
+    expect(after.get(ids[0])).toBeLessThan(before.get(ids[0])!);
+    expect(after.get(ids[2])).toBeGreaterThan(before.get(ids[2])!);
+    expect(next.count).toBe(1);
+    expect(next.canUndo).toBe(true);
+    expect(next.lastAnswer!.text).toMatch(/^Album 1 \d+ → \d+, Album 3 \d+ → \d+$/);
+  });
+
+  it("undo restores the ratings exactly and serves the undone pair again", () => {
+    const before = loadRatings(db).ratings;
+    answerMatchup(db, ids[0], ids[2], "a", [], random);
+    answerMatchup(db, ids[1], ids[3], "tie", [], random);
+
+    const first = asView(undoMatchup(db, [], random));
+    expect(first.pair!.a.id).toBe(ids[1]);
+    expect(first.pair!.b.id).toBe(ids[3]);
+    expect(first.count).toBe(1);
+
+    const second = asView(undoMatchup(db, [], random));
+    expect([second.pair!.a.id, second.pair!.b.id]).toEqual([ids[0], ids[2]]);
+    expect(second.count).toBe(0);
+    expect(second.canUndo).toBe(false);
+    expect(second.lastAnswer!.text).toMatch(/^Undone: /);
+    expect(loadRatings(db).ratings).toEqual(before);
+  });
+
+  it("undo with nothing stored is an error", () => {
+    expect(undoMatchup(db, [], random)).toEqual({ error: "There is nothing to undo." });
+  });
+
+  it("skip stores nothing and serves another pair", () => {
+    const first = loadMatchupState(db, new Set(), random).pair!;
+    const next = asView(skipMatchup(db, first.a.id, first.b.id, [], random));
+
+    expect(countMatchups(db)).toBe(0);
+    expect(next.lastAnswer).toBeNull();
+    expect([next.pair!.a.id, next.pair!.b.id].sort()).not.toEqual([first.a.id, first.b.id].sort());
+  });
+
+  it.each([
+    { name: "same year", a: 0, b: 1 },
+    { name: "a listed album", a: 0, b: 4 },
+    { name: "an album with no year entry", a: 0, b: 5 },
+    { name: "an unknown album", a: 0, b: -1 },
+    { name: "the same album twice", a: 0, b: 0 },
+  ])("refuses $name and stores nothing", ({ a, b }) => {
+    const pick = (i: number) => (i < 0 ? 9999 : ids[i]);
+    expect(answerMatchup(db, pick(a), pick(b), "a", [], random)).toHaveProperty("error");
+    expect(listMatchups(db)).toEqual([]);
+  });
+
+  it.each([
+    { name: "a non-integer id", a: 1.5, result: "a" },
+    { name: "an unknown result", a: 1, result: "draw" },
+  ])("refuses $name", ({ a, result }) => {
+    expect(answerMatchup(db, a, 2, result, [], random)).toHaveProperty("error");
+    expect(countMatchups(db)).toBe(0);
+  });
+
+  it("never serves a listed or unplaced album", () => {
+    const served = new Set<number>();
+    for (const value of [0, 0.3, 0.6, 0.99]) {
+      const { pair } = loadMatchupState(db, new Set(), () => value);
+      served.add(pair!.a.id).add(pair!.b.id);
+    }
+    expect(served.has(ids[4])).toBe(false);
+    expect(served.has(ids[5])).toBe(false);
+  });
+});
diff --git a/lib/matchups-service.ts b/lib/matchups-service.ts
new file mode 100644
index 0000000..c22faaa
--- /dev/null
+++ b/lib/matchups-service.ts
@@ -0,0 +1,122 @@
+import type { DatabaseSync } from "node:sqlite";
+import { DataError, type MatchupResult } from "./db/types";
+import { listAllYearEntries } from "./db/year-entries";
+import { countMatchups, recordMatchup, undoLastMatchup } from "./db/matchups";
+import { pairKey } from "./elo/pick";
+import { loadAlbumCard, loadMatchupState, loadRatings, type AlbumCard } from "./ratings";
+
+export type MatchupView = {
+  pair: { a: AlbumCard; b: AlbumCard } | null;
+  /** Every matchup ever stored, not only this session's. */
+  count: number;
+  lastAnswer: { text: string } | null;
+  canUndo: boolean;
+};
+
+export type MatchupActionResult = MatchupView | { error: string };
+
+const RESULTS: MatchupResult[] = ["a", "b", "tie"];
+const PAIR_KEY = /^\d+-\d+$/;
+const MAX_AVOID = 100_000;
+
+function isId(value: unknown): value is number {
+  return Number.isInteger(value) && (value as number) > 0;
+}
+
+/** Keeps only well-formed pair keys, since the browser can send anything. */
+function parseAvoid(avoid: unknown): Set<string> {
+  if (!Array.isArray(avoid)) return new Set();
+  return new Set(avoid.slice(0, MAX_AVOID).filter((key): key is string => typeof key === "string" && PAIR_KEY.test(key)));
+}
+
+function view(db: DatabaseSync, avoid: Set<string>, random: () => number, lastAnswer: MatchupView["lastAnswer"]): MatchupView {
+  const { pair, count } = loadMatchupState(db, avoid, random);
+  return { pair, count, lastAnswer, canUndo: count > 0 };
+}
+
+function round(rating: number): number {
+  return Math.round(rating);
+}
+
+/** "Title 1500 → 1516, Other 1500 → 1484", or null when either album has no rating on one side. */
+function changeText(
+  before: Map<number, number>,
+  after: Map<number, number>,
+  albums: { id: number; title: string }[],
+  prefix = "",
+): string | null {
+  const parts: string[] = [];
+  for (const { id, title } of albums) {
+    const was = before.get(id);
+    const now = after.get(id);
+    if (was === undefined || now === undefined) return null;
+    parts.push(`${title} ${round(was)} → ${round(now)}`);
+  }
+  return prefix + parts.join(", ");
+}
+
+export function answerMatchup(
+  db: DatabaseSync,
+  albumAId: unknown,
+  albumBId: unknown,
+  result: unknown,
+  avoid: unknown,
+  random: () => number = Math.random,
+): MatchupActionResult {
+  if (!isId(albumAId) || !isId(albumBId) || albumAId === albumBId || !RESULTS.includes(result as MatchupResult)) {
+    return { error: "That answer wasn't valid. Try again." };
+  }
+  const before = loadRatings(db).ratings;
+  const entries = listAllYearEntries(db);
+  const yearOf = (id: number) => entries.find((entry) => entry.albumId === id)?.year;
+  if (!before.has(albumAId) || !before.has(albumBId) || yearOf(albumAId) === yearOf(albumBId)) {
+    return { error: "Those two albums can't be compared. Skip them or reload the page." };
+  }
+
+  try {
+    recordMatchup(db, { albumAId, albumBId, result: result as MatchupResult });
+  } catch (error) {
+    if (error instanceof DataError) return { error: error.message };
+    throw error;
+  }
+
+  const after = loadRatings(db).ratings;
+  const a = loadAlbumCard(db, albumAId)!;
+  const b = loadAlbumCard(db, albumBId)!;
+  return view(db, parseAvoid(avoid), random, { text: changeText(before, after, [a, b])! });
+}
+
+/** Records nothing. The skipped pair is avoided from now on, so the next pair is a different one. */
+export function skipMatchup(
+  db: DatabaseSync,
+  albumAId: unknown,
+  albumBId: unknown,
+  avoid: unknown,
+  random: () => number = Math.random,
+): MatchupActionResult {
+  if (!isId(albumAId) || !isId(albumBId) || albumAId === albumBId) {
+    return { error: "That pair wasn't valid. Reload the page." };
+  }
+  const avoided = parseAvoid(avoid).add(pairKey(albumAId, albumBId));
+  return view(db, avoided, random, null);
+}
+
+/** Deletes the newest matchup and serves its pair again, so the user can answer it differently. */
+export function undoMatchup(db: DatabaseSync, avoid: unknown, random: () => number = Math.random): MatchupActionResult {
+  const before = loadRatings(db).ratings;
+  const undone = undoLastMatchup(db);
+  if (!undone) return { error: "There is nothing to undo." };
+
+  const after = loadRatings(db).ratings;
+  const a = loadAlbumCard(db, undone.albumAId);
+  const b = loadAlbumCard(db, undone.albumBId);
+  const text = a && b ? changeText(before, after, [a, b], "Undone: ") : null;
+  const lastAnswer = { text: text ?? "Undone." };
+
+  if (a && b && after.has(a.id) && after.has(b.id) && a.year !== b.year) {
+    const count = countMatchups(db);
+    return { pair: { a, b }, count, lastAnswer, canUndo: count > 0 };
+  }
+  // One of the albums has lost its placement since, so the pair can't be asked again.
+  return view(db, parseAvoid(avoid), random, lastAnswer);
+}
diff --git a/lib/ratings.ts b/lib/ratings.ts
new file mode 100644
index 0000000..23ba560
--- /dev/null
+++ b/lib/ratings.ts
@@ -0,0 +1,43 @@
+import type { DatabaseSync } from "node:sqlite";
+import { getAlbum } from "./db/albums";
+import { listMatchups, countMatchups } from "./db/matchups";
+import { listAllYearEntries } from "./db/year-entries";
+import { pickMatchup } from "./elo/pick";
+import { computeRatings, type ReplayMatchup } from "./elo/replay";
+
+export type AlbumCard = {
+  id: number;
+  title: string;
+  artist: string;
+  year: number;
+  coverUrl: string | null;
+};
+
+/** Ratings are replayed from the stored year entries and matchups on every call, never stored. */
+export function loadRatings(db: DatabaseSync): { ratings: Map<number, number>; used: ReplayMatchup[] } {
+  return computeRatings({ entries: listAllYearEntries(db), matchups: listMatchups(db) });
+}
+
+export function loadAlbumCard(db: DatabaseSync, albumId: number): AlbumCard | undefined {
+  const album = getAlbum(db, albumId);
+  const entry = listAllYearEntries(db).find((e) => e.albumId === albumId);
+  if (!album || !entry) return undefined;
+  return { id: album.id, title: album.title, artist: album.artist.name, year: entry.year, coverUrl: album.coverUrl };
+}
+
+/** The next pair to ask about (or null when none is possible), the stored matchup total and the ratings. */
+export function loadMatchupState(
+  db: DatabaseSync,
+  avoid: Set<string>,
+  random: () => number,
+): { pair: { a: AlbumCard; b: AlbumCard } | null; count: number; ratings: Map<number, number> } {
+  const entries = listAllYearEntries(db);
+  const { ratings, used } = computeRatings({ entries, matchups: listMatchups(db) });
+  const years = new Map(entries.map((entry) => [entry.albumId, entry.year]));
+  const albums = [...ratings].map(([id, rating]) => ({ id, rating, year: years.get(id)! }));
+
+  const picked = pickMatchup({ albums, matchups: used, avoid, random });
+  const a = picked && loadAlbumCard(db, picked.a);
+  const b = picked && loadAlbumCard(db, picked.b);
+  return { pair: a && b ? { a, b } : null, count: countMatchups(db), ratings };
+}
