{
  "name": "album-ranker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.ts",
    "db:backup": "node scripts/backup.ts",
    "db:restore": "node scripts/restore.ts",
    "import": "node --conditions=react-server scripts/import.ts",
    "backfill-covers": "node --conditions=react-server scripts/backfill-covers.ts",
    "import:fixture": "node lib/import/fixtures/make-fixture.ts",
    "preview": "node scripts/preview.ts",
    "record": "node scripts/record.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.20",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "write-excel-file": "^4.1.1"
  }
}
