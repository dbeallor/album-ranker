# Path of the SQLite file. Optional; this is the default.
DATABASE_PATH=./data/album-ranker.db

# User-Agent sent to MusicBrainz for album search. Optional; this is the default.
# MusicBrainz asks for contact details so they can reach you if the app misbehaves,
# for example: MUSICBRAINZ_USER_AGENT=album-ranker/0.1 (you@example.com)
MUSICBRAINZ_USER_AGENT=album-ranker/0.1
