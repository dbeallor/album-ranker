# Path of the SQLite file. Optional; this is the default.
DATABASE_PATH=./data/album-ranker.db

# Folder for database backups. Optional; this is the default (~ is your home directory).
# Keep it outside the checkout so deleting a worktree doesn't delete the backups.
BACKUP_DIR=~/.album-ranker/backups

# User-Agent sent to MusicBrainz for album search. Optional; this is the default.
# MusicBrainz asks for contact details so they can reach you if the app misbehaves,
# for example: MUSICBRAINZ_USER_AGENT=album-ranker/0.1 (you@example.com)
MUSICBRAINZ_USER_AGENT=album-ranker/0.1

# Base URL of the MusicBrainz API. Optional; this is the default. The browser tests point it
# at a local stub so they never call the live service.
MUSICBRAINZ_URL=https://musicbrainz.org

# Base URLs of the Cover Art Archive and the Deezer API, which the server asks for album covers.
# Optional; these are the defaults. The browser tests point them at a local stub so they never call the live services.
COVER_ART_ARCHIVE_URL=https://coverartarchive.org
DEEZER_URL=https://api.deezer.com
